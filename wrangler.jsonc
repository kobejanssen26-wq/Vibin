{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mingo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@shared/constants": "./src/shared/constants.ts",
    "@shared/types": "./src/shared/types.ts"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mingo-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mingo-media"
    }
  ],
  "env": {
    "staging": {
      "name": "mingo-staging",
      "vars": {
        "APP_ENV": "staging",
        "APP_URL": "https://staging.mingo.app"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mingo-db-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        { "binding": "KV", "id": "REPLACE_WITH_STAGING_KV_NAMESPACE_ID" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "mingo-media-staging" }
      ]
    },
    "production": {
      "name": "mingo",
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://mingo.app"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mingo-db",
          "database_id": "REPLACE_WITH_PROD_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        { "binding": "KV", "id": "REPLACE_WITH_PROD_KV_NAMESPACE_ID" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "mingo-media" }
      ]
    }
  }
}
