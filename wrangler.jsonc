{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibin",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "alias": {
    "@shared/constants": "./src/shared/constants.ts",
    "@shared/types": "./src/shared/types.ts"
  },
  // Sync live-event sources + roll event statuses (upcoming -> live -> completed)
  // every 30 min. A no-op until an event source is enabled in the Command Center.
  "triggers": { "crons": ["*/30 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "vars": {
    "APP_ENV": "production",
    // Canonical origin. Once vibin.be is attached as a Custom Domain in the
    // Cloudflare dashboard this is the live URL; until then the site is also
    // reachable at the *.workers.dev URL printed by `wrangler deploy`.
    "APP_URL": "https://vibin.be"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibin-db",
      "database_id": "a794e4c2-f107-436e-a285-e5ddcaf7fb96",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f3474231263f41679e49437d440c9072"
    }
  ]
  // R2 (photo uploads) is optional. To enable: turn on R2 in the Cloudflare
  // dashboard, `wrangler r2 bucket create vibin-media`, then add:
  //   "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vibin-media" }]
}
