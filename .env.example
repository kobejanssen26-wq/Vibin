# ---------------------------------------------------------------------------
# VIBIN environment configuration
# ---------------------------------------------------------------------------
# Runtime bindings (D1, KV, R2) are configured in wrangler.jsonc, NOT here.
# This file documents the SECRETS and deploy-time values you must provide.
#
# Local dev:   copy the runtime secrets into `.dev.vars` (git-ignored).
# Production:  set them with `wrangler secret put <NAME>` or as GitHub secrets.
# ---------------------------------------------------------------------------

# Reserved for signed tokens. Not required yet (sessions are opaque + KV-backed),
# but set a strong random value in production so it is ready:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Transactional email (verification + password reset). Leave blank in
# development — VIBIN logs the link to the Worker console instead of sending.
EMAIL_API_KEY=
EMAIL_FROM=hello@vibin.be

# ---------------------------------------------------------------------------
# Owner Command Center (/admin)
# ---------------------------------------------------------------------------
# Application-level encryption key for the credential vault and TOTP secrets.
# REQUIRED before running owner first-time setup. Base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit this. Rotate by re-encrypting stored secrets (see README).
ENCRYPTION_KEY=

# Break-glass owner recovery. A long random string held ONLY in deployment
# secrets. Presenting it (server-side, rate-limited, audited) triggers a
# one-shot owner password-reset email + MFA clear. It is NOT a login and
# grants no session. Leave blank to disable recovery entirely.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OWNER_RECOVERY_SECRET=

# Optional: image API for sourcing licensed activity photos when curating the
# catalogue (see seed/activities.ts). Not needed to run the app.
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# CI / deployment only (GitHub Actions secrets — never committed)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
