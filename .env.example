# ---------------------------------------------------------------------------
# Mingo environment configuration
# ---------------------------------------------------------------------------
# Runtime bindings (D1, KV, R2) are configured in wrangler.jsonc, NOT here.
# This file documents the SECRETS and deploy-time values you must provide.
#
# Local dev:  copy the runtime secrets into `.dev.vars` (git-ignored).
# Production: set them with `wrangler secret put <NAME>` (or GitHub Actions).
# ---------------------------------------------------------------------------

# Signing key for session tokens & CSRF tokens. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional: transactional email provider for verification / password reset.
# Leave blank in development — Mingo falls back to logging the link to the console.
EMAIL_API_KEY=
EMAIL_FROM=hello@mingo.app

# ---------------------------------------------------------------------------
# CI / deployment only (GitHub Actions secrets — never committed)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
